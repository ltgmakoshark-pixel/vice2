<body>

<img id="photo" src="photos/1.jpg" alt="Photo Viewer">

<!-- Crisp HTML/CSS Overlay replacing the blurry image text -->
<div id="redeem-overlay">
    <div class="emoji">💸</div>
    <div class="text-content">
        <span class="title">Deal Redeemed</span>
        <span class="timestamp" id="timestamp-text">Monday, Jan 26, at 3:38 PM</span>
    </div>
</div>

<div class="tap-zone left" onclick="prev()"></div>
<div class="tap-zone right" onclick="next()"></div>

<script>
    let current = 1;
    const total = 2; // total number of photos

    const photo = document.getElementById("photo");
    const overlay = document.getElementById("redeem-overlay");
    const timestampText = document.getElementById("timestamp-text");

    function updateTimestamp() {
        const now = new Date();
        
        // Format options to match "Monday, Jan 26, at 3:38 PM" style exactly
        const optionsDate = { weekday: 'long', month: 'short', day: 'numeric' };
        const dateStr = now.toLocaleDateString('en-US', optionsDate);
        
        const optionsTime = { hour: 'numeric', minute: '2-digit', hour12: true };
        const timeStr = now.toLocaleTimeString('en-US', optionsTime);

        timestampText.textContent = `${dateStr}, at ${timeStr}`;
    }

    function show() {
        if (current === 1) {
            photo.src = "photos/1.jpg";
            overlay.style.display = "none"; // Hide overlay on photo 1
        } else if (current === 2) {
            updateTimestamp(); // Generates the fresh live date/time right when switching to photo 2
            photo.src = "photos/2.jpg"; // (or 'photos/2_base.jpg' if you cropped the old blurry banner out)
            overlay.style.display = "flex"; // Show crisp text overlay
        }
    }

    function next() {
        current++;
        if (current > total) current = 1;
        show();
    }

    function prev() {
        current--;
        if (current < 1) current = total;
        show();
    }

    // Hide mobile Safari URL bar on load
    window.addEventListener("load", function() {
        setTimeout(() => window.scrollTo(0, 1), 0);
    });

    // Swipe left/right support
    let startX = 0;
    window.addEventListener("touchstart", e => { startX = e.touches[0].clientX; });
    window.addEventListener("touchend", e => {
        let endX = e.changedTouches[0].clientX;
        if (endX - startX > 50) prev();      // swipe right
        else if (startX - endX > 50) next(); // swipe left
    });
</script>

</body>
</html>
